# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Secrets: never commit ---
# Only .env.example is tracked, and it must contain placeholders only.
.env
.env.*
!.env.example
*.env
copy.env.rtf

# --- Auth sessions / tokens: never commit ---
# Browser session files grant account access; they are not detectable by
# API-key pattern scanners, so they must be excluded by filename.
*session*.json
*_session.json
*cookies*.json
*token*.json
.auth/
